// Board95 database schema (Milestone 3A).
// Not yet created: Activity, SelfDriveRequest and Payment tables.
// We add each when its milestone arrives.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma 7).
}

enum City {
  Blantyre
  Lilongwe
  Mzuzu
}

enum CarHireDistrict {
  BALAKA
  BLANTYRE
  CHIKWAWA
  CHIRADZULU
  CHITIPA
  DEDZA
  DOWA
  KARONGA
  KASUNGU
  LIKOMA
  LILONGWE
  MACHINGA
  MANGOCHI
  MCHINJI
  MULANJE
  MWANZA
  MZIMBA
  NENO
  NKHATABAY
  NKHOTAKOTA
  NSANJE
  NTCHEU
  NTCHISI
  PHALOMBE
  RUMPHI
  SALIMA
  THYOLO
  ZOMBA
}

enum TransportType {
  BUS
  TAXI
}

enum OperatorKind {
  BUS_COMPANY
  TAXI_OWNER
}

// Buses leave from a company STATION; taxis leave from a STAGE.

enum DeparturePointKind {
  STATION
  STAGE
}

enum UserRole {
  CUSTOMER
  OWNER
  CAR_HIRER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ApplicationKind {
  TAXI_OWNER
  BUS_COMPANY
  CAR_HIRER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum CarHireRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CarHireVehicleType {
  SALOON
  SUV
  PICKUP
  MINIBUS
  BUS
  TRUCK
  LORRY
  VAN
  OTHER
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OperatorMemberRole {
  ADMIN
  STAFF
}

// The User model's core fields (id, email, emailVerified, name, image,
// createdAt, updatedAt) are managed by Better Auth. role and phone are our
// own additions, wired in as Better Auth "additional fields".

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?  @unique
  role          UserRole @default(CUSTOMER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  operators           Operator[] // companies/vehicles this user owns
  bookings            Booking[]
  carListings         CarHireListing[]
  applications        Application[]
  sentBookingMessages BookingMessage[] @relation("BookingMessageSender")
  carHireRequests     CarHireRequest[]
  operatorMemberships OperatorMember[]

  @@map("user")
}

// Everything below this line is Better Auth's own schema (Milestone 3B).

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // the user's hashed password, for email/password sign-in
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A bus company or an individual taxi owner.

model Operator {
  id        String       @id @default(cuid())
  name      String
  kind      OperatorKind
  verified  Boolean      @default(false) // set by an admin (Milestone 6)
  active    Boolean      @default(true) // "disable" instead of deleting
  phone     String? // public contact, shown for bus companies only
  ownerId   String?
  owner     User?        @relation(fields: [ownerId], references: [id])
  createdAt DateTime     @default(now())

  vehicles        Vehicle[]
  trips           Trip[]
  departurePoints DeparturePoint[]
  members         OperatorMember[]

  @@index([ownerId])
}

model Vehicle {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  model      String
  plate      String   @unique
  seats      Int

  trips Trip[]

  @@index([operatorId])
}

model DeparturePoint {
  id         String             @id @default(cuid())
  city       City
  name       String
  kind       DeparturePointKind
  operatorId String? // set for a company's own station
  operator   Operator?          @relation(fields: [operatorId], references: [id])

  trips Trip[]

  @@index([city])
}

model Trip {
  id               String         @id @default(cuid())
  operatorId       String
  operator         Operator       @relation(fields: [operatorId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  departurePointId String
  departurePoint   DeparturePoint @relation(fields: [departurePointId], references: [id])

  type            TransportType
  origin          City
  destination     City
  departureAt     DateTime // stored in UTC; shown in Malawi time (UTC+2)
  createdAt       DateTime       @default(now())
  fareMWK         Int // whole kwacha, no decimals
  seatsTotal      Int
  seatsAvailable  Int
  pickupAvailable Boolean       @default(false)
  pickupFeeMWK    Int?

  bookings Booking[]

  // Speeds up the search on /transport.
  @@index([origin, destination, departureAt])
  @@index([departureAt, id])
  @@index([operatorId, departureAt])
  @@index([vehicleId, departureAt])
  @@index([departurePointId])
}

model Booking {
  id                        String           @id @default(cuid())
  tripId                    String
  trip                      Trip             @relation(fields: [tripId], references: [id])
  userId                    String?
  user                      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName                 String?
  guestPhone                String?
  guestEmail                String?
  pickupLocation            String?
  seats                     Int              @default(1)
  pickupRequested           Boolean          @default(false)
  totalMWK                  Int
  status                    BookingStatus    @default(PENDING)
  reviewedByAdmin           Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  archivedAt                DateTime?
  guestAccessTokenHash      String?
  guestAccessTokenExpiresAt DateTime?
  messages                  BookingMessage[]

  @@index([userId])
  @@index([tripId])
  @@index([guestPhone, userId])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([userId, archivedAt, createdAt])
}

model CarHireListing {
  id           String           @id @default(cuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  model        String
  vehicleType  CarHireVehicleType @default(OTHER)
  lorryCapacityTons Int?
  contactPhone String?
  district     CarHireDistrict
  dailyRateMWK Int
  description  String?
  photoUrl     String?
  available    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  requests     CarHireRequest[]

  @@index([ownerId])
  @@index([district, available])
  @@index([available, createdAt, id])
  @@index([ownerId, createdAt, id])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ApplicationKind
  status      ApplicationStatus @default(PENDING)
  displayName String
  phone       String
  createdAt   DateTime          @default(now())
  reviewedAt  DateTime?
  reviewedByAdmin Boolean          @default(false)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BookingMessage {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?    @relation("BookingMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  guestSenderName String?
  body            String
  createdAt       DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([senderId, createdAt])
}

model CarHireRequest {
  id          String               @id @default(cuid())
  listingId   String
  listing     CarHireListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  passengerId String?
  passenger   User?                @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  guestName   String
  guestPhone  String
  guestEmail  String?
  startsAt    DateTime
  endsAt      DateTime
  totalMWK    Int
  status      CarHireRequestStatus @default(PENDING)
  reviewedByAdmin Boolean          @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([listingId, startsAt, endsAt])
  @@index([passengerId, createdAt])
  @@index([status, createdAt])
}

model RateLimitBucket {
  keyHash   String   @id
  attempts  Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model EmailDelivery {
  id        String              @id @default(cuid())
  recipient String
  subject   String
  lines     Json
  action    Json?
  status    EmailDeliveryStatus @default(PENDING)
  attempts  Int                 @default(0)
  lastError String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  sentAt    DateTime?

  @@index([status, createdAt])
}

model OperatorMember {
  id         String             @id @default(cuid())
  operatorId String
  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       OperatorMemberRole
  createdAt  DateTime           @default(now())

  @@unique([operatorId, userId])
  @@index([userId, role])
}

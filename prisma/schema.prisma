// Board95 database schema (Milestone 3A).
// Not yet created: Activity, SelfDriveRequest and Payment tables.
// We add each when its milestone arrives.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma 7).
}

enum City {
  Blantyre
  Lilongwe
  Mzuzu
}

enum TransportType {
  BUS
  TAXI
}

enum OperatorKind {
  BUS_COMPANY
  TAXI_OWNER
}

// Buses leave from a company STATION; taxis leave from a STAGE.

enum DeparturePointKind {
  STATION
  STAGE
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

// The User model's core fields (id, email, emailVerified, name, image,
// createdAt, updatedAt) are managed by Better Auth. role and phone are our
// own additions, wired in as Better Auth "additional fields".

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?  @unique
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  operators Operator[] // companies/vehicles this user owns
  bookings  Booking[]

  @@map("user")
}

// Everything below this line is Better Auth's own schema (Milestone 3B).

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // the user's hashed password, for email/password sign-in
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A bus company or an individual taxi owner.

model Operator {
  id        String       @id @default(cuid())
  name      String
  kind      OperatorKind
  verified  Boolean      @default(false) // set by an admin (Milestone 6)
  active    Boolean      @default(true) // "disable" instead of deleting
  phone     String? // public contact, shown for bus companies only
  ownerId   String?
  owner     User?        @relation(fields: [ownerId], references: [id])
  createdAt DateTime     @default(now())

  vehicles        Vehicle[]
  trips           Trip[]
  departurePoints DeparturePoint[]
}

model Vehicle {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  model      String
  plate      String   @unique
  seats      Int

  trips Trip[]
}

model DeparturePoint {
  id         String             @id @default(cuid())
  city       City
  name       String
  kind       DeparturePointKind
  operatorId String? // set for a company's own station
  operator   Operator?          @relation(fields: [operatorId], references: [id])

  trips Trip[]

  @@index([city])
}

model Trip {
  id               String         @id @default(cuid())
  operatorId       String
  operator         Operator       @relation(fields: [operatorId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  departurePointId String
  departurePoint   DeparturePoint @relation(fields: [departurePointId], references: [id])

  type            TransportType
  origin          City
  destination     City
  departureAt     DateTime // stored in UTC; shown in Malawi time (UTC+2)
  fareMWK         Int // whole kwacha, no decimals
  seatsTotal      Int
  seatsAvailable  Int
  pickupAvailable Boolean       @default(false)
  pickupFeeMWK    Int?

  bookings Booking[]

  // Speeds up the search on /transport.
  @@index([origin, destination, departureAt])
}

model Booking {
  id              String        @id @default(cuid())
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  seats           Int           @default(1)
  pickupRequested Boolean       @default(false)
  totalMWK        Int
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([tripId])
}

// Board95 database schema (Milestone 3A).
// Not yet created: Activity, SelfDriveRequest and Payment tables.
// We add each when its milestone arrives.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma 7).
}

enum City {
  Balaka
  Blantyre
  Chikwawa
  Chiradzulu
  Chitipa
  Dedza
  Dowa
  Karonga
  Kasungu
  Likoma
  Lilongwe
  Machinga
  Mangochi
  Mchinji
  Mulanje
  Mwanza
  Mzimba
  Neno
  NkhataBay
  Nkhotakota
  Nsanje
  Ntcheu
  Ntchisi
  Phalombe
  Rumphi
  Salima
  Thyolo
  Zomba
  Mzuzu
}

enum CarHireDistrict {
  BALAKA
  BLANTYRE
  CHIKWAWA
  CHIRADZULU
  CHITIPA
  DEDZA
  DOWA
  KARONGA
  KASUNGU
  LIKOMA
  LILONGWE
  MACHINGA
  MANGOCHI
  MCHINJI
  MULANJE
  MWANZA
  MZIMBA
  NENO
  NKHATABAY
  NKHOTAKOTA
  NSANJE
  NTCHEU
  NTCHISI
  PHALOMBE
  RUMPHI
  SALIMA
  THYOLO
  ZOMBA
}

enum TransportType {
  BUS
  TAXI
}

enum OperatorKind {
  BUS_COMPANY
  TAXI_OWNER
}

// Buses leave from a company STATION; taxis leave from a STAGE.

enum DeparturePointKind {
  STATION
  STAGE
}

enum UserRole {
  CUSTOMER
  OWNER
  CAR_HIRER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ApplicationKind {
  TAXI_OWNER
  BUS_COMPANY
  CAR_HIRER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum CarHireRequestStatus {
  COMPLETED
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CarHireVehicleType {
  SALOON
  SUV
  PICKUP
  MINIBUS
  BUS
  TRUCK
  LORRY
  VAN
  OTHER
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OperatorMemberRole {
  ADMIN
  STAFF
}

// The User model's core fields (id, email, emailVerified, name, image,
// createdAt, updatedAt) are managed by Better Auth. role and phone are our
// own additions, wired in as Better Auth "additional fields".

model Board95EmailSettings {
  id             String @id @default("board95")
  primaryEmail   String
  secondaryEmail String?
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?  @unique
  role          UserRole @default(CUSTOMER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  operators           Operator[] // companies/vehicles this user owns
  bookings            Booking[]
  carListings         CarHireListing[]
  carListingHistory   CarHireListingHistory[]
  applications        Application[]
  sentBookingMessages BookingMessage[]        @relation("BookingMessageSender")
  carHireRequests     CarHireRequest[]
  operatorMemberships OperatorMember[]

  @@map("user")
}

// Everything below this line is Better Auth's own schema (Milestone 3B).

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // the user's hashed password, for email/password sign-in
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A bus company or an individual taxi owner.

model Operator {
  id        String       @id @default(cuid())
  name      String
  kind      OperatorKind
  verified  Boolean      @default(false) // set by an admin (Milestone 6)
  active    Boolean      @default(true) // "disable" instead of deleting
  phone     String? // public contact, shown for bus companies only
  ownerId   String?
  owner     User?        @relation(fields: [ownerId], references: [id])
  createdAt DateTime     @default(now())

  vehicles        Vehicle[]
  trips           Trip[]
  busSchedules    BusSchedule[]
  tripHistory     TripHistory[]
  departurePoints DeparturePoint[]
  members         OperatorMember[]

  @@index([ownerId])
}

model Vehicle {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  model      String
  plate      String   @unique
  seats      Int
  active     Boolean @default(true)

  trips       Trip[]
  busSchedules BusSchedule[]
  tripHistory TripHistory[]

  @@index([operatorId])
}

model DeparturePoint {
  id         String             @id @default(cuid())
  city       City
  name       String
  kind       DeparturePointKind
  operatorId String? // set for a company's own station
  operator   Operator?          @relation(fields: [operatorId], references: [id])

  trips       Trip[]
  busSchedules BusSchedule[]
  tripHistory TripHistory[]

  @@index([city])
}

model Trip {
  id               String         @id @default(cuid())
  operatorId       String
  operator         Operator       @relation(fields: [operatorId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  departurePointId String
  departurePoint   DeparturePoint @relation(fields: [departurePointId], references: [id])
  scheduleId       String?
  schedule         BusSchedule?   @relation(fields: [scheduleId], references: [id])
  serviceDate      String? // Malawi calendar day; one departure per schedule per day.
  scheduleOverride Boolean @default(false)
  cancelled        Boolean @default(false)

  type            TransportType
  origin          City
  destination     City
  departureAt     DateTime // stored in UTC; shown in Malawi time (UTC+2)
  createdAt       DateTime      @default(now())
  fareMWK         Int // whole kwacha, no decimals
  seatsTotal      Int
  seatsAvailable  Int
  pickupAvailable Boolean       @default(false)
  pickupFeeMWK    Int?

  bookings Booking[]

  // Speeds up the search on /transport.
  @@index([origin, destination, departureAt])
  @@index([departureAt, id])
  @@index([operatorId, departureAt])
  @@index([vehicleId, departureAt])
  @@index([departurePointId])
  @@unique([scheduleId, serviceDate])
}

// A persistent timetable. Each date gets its own Trip and seat inventory.
model BusSchedule {
  id               String         @id @default(cuid())
  operatorId       String
  operator         Operator       @relation(fields: [operatorId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  departurePointId String
  departurePoint   DeparturePoint @relation(fields: [departurePointId], references: [id])
  origin           City
  destination      City
  departureTime    String // HH:mm in Malawi time.
  weekdays         Int[]          @default([0, 1, 2, 3, 4, 5, 6]) // Sunday = 0.
  fareMWK          Int
  seatsTotal       Int
  pickupAvailable  Boolean        @default(false)
  pickupFeeMWK     Int?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  trips            Trip[]

  @@index([operatorId, active])
  @@index([vehicleId])
  @@index([departurePointId])
}

model Booking {
  id                        String           @id @default(cuid())
  tripId                    String?
  trip                      Trip?            @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripHistoryId             String?
  tripHistory               TripHistory?     @relation(fields: [tripHistoryId], references: [id], onDelete: Restrict)
  userId                    String?
  user                      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName                 String?
  guestPhone                String?
  guestEmail                String?
  pickupLocation            String?
  seats                     Int              @default(1)
  pickupRequested           Boolean          @default(false)
  totalMWK                  Int
  status                    BookingStatus    @default(PENDING)
  reviewedByAdmin           Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  archivedAt                DateTime?
  review                    ServiceReview?
  whatsappUpdates           Boolean @default(false)
  guestAccessTokenHash      String?
  guestAccessTokenExpiresAt DateTime?
  messages                  BookingMessage[]

  @@index([userId])
  @@index([tripId])
  @@index([tripHistoryId])
  @@index([guestPhone, userId])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([userId, archivedAt, createdAt])
}

model CarHireListing {
  id                String             @id @default(cuid())
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  model             String
  vehicleType       CarHireVehicleType @default(OTHER)
  lorryCapacityTons Int?
  contactPhone      String?
  district          CarHireDistrict
  dailyRateMWK      Int
  description       String?
  photoUrl          String?
  available         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  renewedAt         DateTime?
  expiresAt         DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP + interval '7 days')"))
  requests          CarHireRequest[]

  @@index([ownerId])
  @@index([expiresAt, id])
  @@index([district, available])
  @@index([available, createdAt, id])
  @@index([ownerId, createdAt, id])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            ApplicationKind
  status          ApplicationStatus @default(PENDING)
  displayName     String
  phone           String
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedByAdmin Boolean           @default(false)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BookingMessage {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?    @relation("BookingMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  guestSenderName String?
  body            String
  createdAt       DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([senderId, createdAt])
}

model CarHireRequest {
  id               String                 @id @default(cuid())
  listingId        String?
  listing          CarHireListing?        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingHistoryId String?
  listingHistory   CarHireListingHistory? @relation(fields: [listingHistoryId], references: [id], onDelete: Restrict)
  passengerId      String?
  passenger        User?                  @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  guestName        String
  guestPhone       String
  guestEmail       String?
  startsAt         DateTime
  endsAt           DateTime
  totalMWK         Int
  status           CarHireRequestStatus   @default(PENDING)
  reviewedByAdmin  Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  guestAccessTokenHash String?
  guestAccessTokenExpiresAt DateTime?
  whatsappUpdates Boolean @default(false)
  messages RentalMessage[]
  review ServiceReview?

  @@index([listingId, startsAt, endsAt])
  @@index([listingHistoryId, startsAt, endsAt])
  @@index([passengerId, createdAt])
  @@index([status, createdAt])
}

model RateLimitBucket {
  keyHash   String   @id
  attempts  Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model EmailDelivery {
  id        String              @id @default(cuid())
  recipient String
  subject   String
  lines     Json
  action    Json?
  status    EmailDeliveryStatus @default(PENDING)
  attempts  Int                 @default(0)
  lastError String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  sentAt    DateTime?

  @@index([status, createdAt])
}

model OperatorMember {
  id         String             @id @default(cuid())
  operatorId String
  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       OperatorMemberRole
  createdAt  DateTime           @default(now())

  @@unique([operatorId, userId])
  @@index([userId, role])
}

// Expired listings live outside the active inventory. IDs and booking links are preserved.
model TripHistory {
  id               String         @id
  operatorId       String
  operator         Operator       @relation(fields: [operatorId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  departurePointId String
  departurePoint   DeparturePoint @relation(fields: [departurePointId], references: [id])
  scheduleId       String?
  serviceDate      String?
  scheduleOverride Boolean @default(false)
  cancelled        Boolean @default(false)

  type            TransportType
  origin          City
  destination     City
  departureAt     DateTime // stored in UTC; shown in Malawi time (UTC+2)
  createdAt       DateTime      @default(now())
  fareMWK         Int // whole kwacha, no decimals
  seatsTotal      Int
  seatsAvailable  Int
  pickupAvailable Boolean       @default(false)
  pickupFeeMWK    Int?

  archivedAt         DateTime  @default(now())
  operatorName       String
  vehicleModel       String
  vehiclePlate       String
  departurePointName String
  bookings           Booking[]

  // Speeds up the search on /transport.
  @@index([origin, destination, departureAt])
  @@index([departureAt, id])
  @@index([operatorId, departureAt])
  @@index([vehicleId, departureAt])
  @@index([departurePointId])
}

model CarHireListingHistory {
  id                String             @id
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id])
  name              String
  model             String
  vehicleType       CarHireVehicleType @default(OTHER)
  lorryCapacityTons Int?
  contactPhone      String?
  district          CarHireDistrict
  dailyRateMWK      Int
  description       String?
  photoUrl          String?
  available         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  renewedAt         DateTime?
  expiresAt         DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP + interval '7 days')"))
  archivedAt        DateTime           @default(now())
  ownerName         String
  requests          CarHireRequest[]

  @@index([ownerId])
  @@index([expiresAt, id])
  @@index([district, available])
  @@index([available, createdAt, id])
  @@index([ownerId, createdAt, id])
}

model RentalMessage {
 id String @id @default(cuid())
 requestId String
 request CarHireRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
 senderId String?
 body String
 createdAt DateTime @default(now())
 @@index([requestId, createdAt])
}
model ServiceReview {
 id String @id @default(cuid())
 bookingId String? @unique
 booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
 rentalRequestId String? @unique
 rentalRequest CarHireRequest? @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)
 operatorId String?
 vehicleId String?
 carListingId String?
 providerUserId String?
 score Int
 note String
 createdAt DateTime @default(now())
 @@index([operatorId])
 @@index([vehicleId])
 @@index([carListingId])
 @@index([providerUserId])
}
model MobileNotification {
 id String @id @default(cuid())
 expiresAt DateTime?
 eventKey String @unique
 phone String
 body String
 whatsappUpdates Boolean @default(false)
 status String @default("QUEUED")
 providerSid String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, createdAt])
}
